#!/bin/bash
# App 需要 setuid root 才能读取 dpkg 数据库
APP="/var/jb/Applications/DebPackUI.app/DebPackUI"
if [ -f "$APP" ]; then
    chown root:wheel "$APP"
    chmod 4755 "$APP"
fi
# 清理 0.1.1 早期构建写错位置的图标（var/jb/var/jb）
rm -rf /var/jb/var/jb/Applications 2>/dev/null || true
# 只注册自己的 App，且必须用 -p 指定路径；
# 绝不跑裸 uicache —— root 下会把 /var/jb/Applications 全部图标缓存清掉
UIC=/var/jb/usr/bin/uicache
[ -x "$UIC" ] && "$UIC" -p /var/jb/Applications/DebPackUI.app >/dev/null 2>&1 || true
exit 0
